{
  "name": "emag-seller-toolkit",
  "private": true,
  "version": "1.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "node scripts/gpsr-layout-smoke.mjs && node scripts/saved-page-smoke.mjs tests/fixtures/emag-columbia.html",
    "probe:emag": "node scripts/probe-emag.mjs",
    "check": "npm run test && npm run lint && npm run build",
    "package": "node scripts/package.mjs --check-config && npm run check && node scripts/package.mjs",
    "package:verify": "node scripts/package.mjs --verify",
    "test:release": "node scripts/release-smoke.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "jsbarcode": "^3.12.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.577.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "svg2pdf.js": "^2.9.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/react": "^16.3.0",
    "@types/chrome": "^0.1.37",
    "@types/jsbarcode": "^3.11.4",
    "@types/node": "^24.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "fflate": "^0.8.3",
    "globals": "^16.5.0",
    "jsdom": "^27.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
